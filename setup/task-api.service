[Unit]
Description=My First Pro Task API
After=network.target

[Service]
Type=simple
WorkingDirectory={{PROJECT_DIR}}
EnvironmentFile=/etc/default/task-api
ExecStart=/usr/bin/npm run api
Restart=always
RestartSec=5
User={{RUN_USER}}
Group={{RUN_GROUP}}

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths={{PROJECT_DIR}}/db {{PROJECT_DIR}}/backups

[Install]
WantedBy=multi-user.target
